# ==============================================================================
# FRIDAY AI Agent — Environment Configuration Example
# Copy this file to .env and fill in your keys (or use the built-in Setup Wizard)
# ==============================================================================

# Google Gemini API Key (Required for Live Voice & Multimodal Vision)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_IMAGE_API_KEY=

# Application Server Port (Default: 3000)
PORT=3000

# Optional LLM Fallback Providers
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Optional Email / Notification Dispatcher
EMAIL_USER=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
