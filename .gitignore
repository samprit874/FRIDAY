# ==============================================================================
# FRIDAY AI Agent — Open-Source .gitignore
# Protects all user credentials, personal memories, runtime databases, and logs.
# ==============================================================================

# Secrets, Environment & API Keys
.env
.env.*
.env.local
!.env.example
secrets.json
!secrets.json.example

# User Runtime Data & Memories
memories.json
latest.json
backups/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch & Temporary Backups
scratch/
recovery-backups/
generated_images/
*.bak
*.bak*
*.tmp
*.temp

# Dependencies & Compiled Modules
node_modules/
dist-runtime/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
